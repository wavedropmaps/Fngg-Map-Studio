# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# PyInstaller output. The exe is a build artefact, not source -- attach it to a
# release rather than committing 34 MB per rebuild.
build/
dist/
*.spec

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local runtime logs
*.log

# NOT ignored, deliberately:
#   app/data/known_versions.txt  - the shipped version list
#   app/data/previews/           - 108 bundled map thumbnails (~3 MB)
# Both are needed at runtime; PyInstaller bundles them via --add-data.
